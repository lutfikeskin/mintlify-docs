{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "TNI Rater Autofill",
  "description": "How the TNI Rater Autofill Chrome extension turns an intake PDF into commercial auto quote answers: its parts, flows, rules, AI assistance, server and tests.",
  "colors": {
    "primary": "#005aa9",
    "light": "#4f8fd0",
    "dark": "#004887"
  },
  "background": {
    "color": {
      "light": "#f8f9fa",
      "dark": "#17222b"
    }
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "favicon": "/favicon.png",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": ["index", "get-started/setup", "get-started/repository-map"]
      },
      {
        "group": "How it works",
        "pages": [
          "how-it-works/architecture",
          "how-it-works/fill-lifecycle",
          "how-it-works/side-panel",
          "how-it-works/data-and-privacy"
        ]
      },
      {
        "group": "Carriers and rules",
        "pages": [
          "carriers-and-rules/intake",
          "carriers-and-rules/rules",
          "carriers-and-rules/browser-filling",
          "carriers-and-rules/carriers",
          "carriers-and-rules/tni-standards",
          "carriers-and-rules/new-carrier"
        ]
      },
      {
        "group": "AI and learning",
        "pages": [
          "ai-and-learning/ai-assistant",
          "ai-and-learning/usage-events",
          "ai-and-learning/learning-loop",
          "ai-and-learning/corrections"
        ]
      },
      {
        "group": "Server and data",
        "pages": [
          "server-and-data/collection-server",
          "server-and-data/daily-review",
          "server-and-data/quoting-history"
        ]
      },
      {
        "group": "Dev workflow",
        "pages": [
          "dev-workflow/testing",
          "dev-workflow/type-checking",
          "dev-workflow/release"
        ]
      }
    ]
  },
  "contextual": {
    "options": ["copy", "view", "claude", "chatgpt", "cursor", "vscode"]
  }
}
